{
  "name": "awardfares-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Personal MCP server for awardfares.com (award search, alerts, journeys, seat maps, schedules)",
  "type": "module",
  "bin": { "awardfares-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "playwright": "^1.55.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
